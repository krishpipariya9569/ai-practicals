def generate_winning_lines(n):
    winning_lines = []

    # Rows
    for i in range(n):
        winning_lines.append([j for j in range(i * n, (i + 1) * n)])

    # Columns
    for i in range(n):
        winning_lines.append([j for j in range(i, n * n, n)])

    # Diagonals
    winning_lines.append([i * (n + 1) for i in range(n)])  # Main diagonal
    winning_lines.append([i * (n - 1) + (n - 1) for i in range(n)])  # Anti-diagonal

    return winning_lines


